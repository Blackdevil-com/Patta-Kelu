# ==============================================================================
#                 PATTA KELU - RENDER DEPLOYMENT ENVIRONMENT CONFIG
# ==============================================================================
# Copy these values into your Render Dashboard under:
#   Backend Web Service -> Environment Variables
#   Frontend Static Site -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (Spring Boot - Render Web Service)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8081

# Supabase PostgreSQL Database Credentials
# (Found in your Supabase Dashboard: Project Settings -> Database -> Connection string -> JDBC / URI)
# NOTE: Replace [YOUR-PASSWORD] with your actual Supabase DB password
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Supabase Project API Keys (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Security & JWT Secrets (Generate a 64+ char hex string for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=2592000000
JWT_REFRESH_EXPIRATION=2592000000

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Vite + React - Render Static Site)
# ------------------------------------------------------------------------------
# URL of your deployed Render Backend Web Service (without trailing slash)
VITE_API_BASE_URL=https://patta-kelu-backend.onrender.com

# Supabase Client Credentials
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
